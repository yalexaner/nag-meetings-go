# ==============================================
# Nag Meetings Bot Configuration
# ==============================================

# ----------------------------------------------
# Required Settings
# ----------------------------------------------

# Telegram Bot Token
# Get your token from @BotFather on Telegram
# Example: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Calendar URL
# The URL of the HTML page containing your calendar events
# This should be publicly accessible (or accessible from where you run the bot)
CALENDAR_URL=https://example.com/calendar

# Working Directory
# Directory where the database file will be stored
# IMPORTANT: Must include trailing slash!
# Examples: /home/user/data/ or /var/lib/nag-meetings/ or ./data/
WORKING_DIRECTORY=/path/to/directory/

# ----------------------------------------------
# Optional Settings
# ----------------------------------------------

# Environment Mode
# Set to "debug" to use local index.html file instead of fetching from URL
# Useful for testing parser configuration without making HTTP requests
# Values: debug | production (or leave empty for production)
# ENVIRONMENT=debug

# ----------------------------------------------
# Parser Configuration
# ----------------------------------------------
# These settings allow you to customize how the bot parses your calendar HTML
# If not set, default values will be used (shown in comments)

# CSS selector for event container elements
# Default: .b-content-event
# Example: .calendar-event, article.event, div[data-event]
# PARSER_EVENT_SELECTOR=.b-content-event

# CSS selector for event title (relative to event container)
# Default: h1
# Example: .event-title, h2, span.title
# PARSER_TITLE_SELECTOR=h1

# Meeting name to match
# The bot will only extract links from events with this exact title
# Default: STB Daily Meeting
# Example: Daily Standup, Team Meeting, Sprint Planning
# PARSER_MEETING_NAME=STB Daily Meeting

# CSS selector for meeting links (relative to event container)
# Default: .e-description a
# Example: .event-link a, a.meeting-url, button
# PARSER_LINK_SELECTOR=.e-description a

# HTML attribute to extract the meeting URL from
# Default: href
# Example: data-meeting-url, data-link, href
# PARSER_LINK_ATTRIBUTE=href

# ----------------------------------------------
# Example Configurations
# ----------------------------------------------

# Example 1: Google Calendar-like structure
# PARSER_EVENT_SELECTOR=.event-item
# PARSER_TITLE_SELECTOR=.event-name
# PARSER_MEETING_NAME=Daily Standup
# PARSER_LINK_SELECTOR=.event-description a
# PARSER_LINK_ATTRIBUTE=href

# Example 2: Custom calendar with data attributes
# PARSER_EVENT_SELECTOR=div[data-type="meeting"]
# PARSER_TITLE_SELECTOR=h3.meeting-title
# PARSER_MEETING_NAME=Team Sync
# PARSER_LINK_SELECTOR=button.join-btn
# PARSER_LINK_ATTRIBUTE=data-meeting-url

# Example 3: Calendar with nested structure
# PARSER_EVENT_SELECTOR=.calendar-day .meeting-card
# PARSER_TITLE_SELECTOR=.card-header h2
# PARSER_MEETING_NAME=All Hands Meeting
# PARSER_LINK_SELECTOR=.card-footer .join-link
# PARSER_LINK_ATTRIBUTE=href
